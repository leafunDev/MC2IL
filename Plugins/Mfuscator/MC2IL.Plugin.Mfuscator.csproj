<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <DebugType>embedded</DebugType>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>MC2IL contributors</Authors>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <Copyright>Copyright © Samboy063 2024-2026</Copyright>
        <Description>Plugin for MC2IL</Description>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>$(MSBuildProjectName)</PackageId>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/leafunDev/MC2IL</PackageProjectUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <Title>$(MSBuildProjectName)</Title>
        <VersionPrefix>1.0.0</VersionPrefix>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\MC2IL.Core\MC2IL.Core.csproj" Private="false" />
      <ProjectReference Include="..\..\LibMC2IL\LibMC2IL.csproj" Private="false" />
      <ProjectReference Include="..\..\StableNameDotNet\StableNameDotNet.csproj" Private="false" />
      <ProjectReference Include="..\..\WasmDisassembler\WasmDisassembler.csproj" Private="false" />
    </ItemGroup>

</Project>
