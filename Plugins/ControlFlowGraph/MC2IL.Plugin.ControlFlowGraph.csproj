<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<DebugType>embedded</DebugType>
        <LangVersion>11</LangVersion>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>MC2IL contributors</Authors>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <Copyright>Copyright © Samboy063 2024-2026</Copyright>
        <Description>Plugin for MC2IL</Description>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>$(MSBuildProjectName)</PackageId>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/leafunDev/MC2IL</PackageProjectUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <Title>$(MSBuildProjectName)</Title>
        <VersionPrefix>1.0.0</VersionPrefix>
    </PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\MC2IL.Core\MC2IL.Core.csproj" ExcludeAssets="All" Private="false"/>
		<ProjectReference Include="..\..\LibMC2IL\LibMC2IL.csproj" ExcludeAssets="All" Private="false"/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DotNetGraph" Version="3.3.0" IncludeAssets="All" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
	</ItemGroup>

</Project>
