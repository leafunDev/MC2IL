<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Authors>MC2IL contributors</Authors>
        <Company>MC2IL</Company>
        <Copyright>Copyright © Samboy063 2022-2026</Copyright>
        <DebugType>embedded</DebugType>
        <Description>Library for generating somewhat stable names for obfuscated types, based on their content.</Description>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Nullable>enable</Nullable>
        <PackageId>StableNameDotNet</PackageId>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/leafunDev/MC2IL.git</RepositoryUrl>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <VersionPrefix>0.1.0</VersionPrefix>
    </PropertyGroup>

</Project>
